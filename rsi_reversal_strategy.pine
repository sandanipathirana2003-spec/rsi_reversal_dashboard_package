//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  RSI 70/30 Reversal — BACKTEST STRATEGY (5m execution + 15m trend)
//  Same signal logic as the dashboard indicator. Use THIS script for
//  Strategy Tester results; use the indicator for the dashboard and alerts.
//  Orders fill at the NEXT bar open (no look-ahead). SL/TP are computed from
//  the signal-bar close and the confirmed 5m Supertrend level.
//
//  IMPORTANT: fees / slippage / leverage are set in the strategy() header
//  and in Settings → Properties. Edit them to match your Binance fee tier.
//  Not financial advice. No profitability is claimed or implied.
// ═══════════════════════════════════════════════════════════════════════════
strategy("RSI 70/30 Reversal BACKTEST (5m + 15m)", shorttitle="RSI-REV BT", overlay=true,
     initial_capital=1000, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.percent, commission_value=0.05,
     slippage=2, pyramiding=0, margin_long=10, margin_short=10,
     process_orders_on_close=false, calc_on_every_tick=false, max_labels_count=200)

// ═════════════════════════════ INPUTS (keep identical to the indicator) ═════════════════════════════
G_RSI  = "1 · RSI"
G_MA   = "2 · MA Ribbon"
G_ST   = "3 · Supertrend"
G_MTF  = "4 · 15m trend filter"
G_CONF = "5 · Confirmation rules"
G_RISK = "6 · Stop / target / sizing"

rsiLen      = input.int(14, "RSI length", minval=2, group=G_RSI)
rsiOS       = input.float(30.0, "Oversold level", group=G_RSI)
rsiOB       = input.float(70.0, "Overbought level", group=G_RSI)
turnMin     = input.float(1.0, "Min RSI rebound to count as a 'turn'", minval=0.0, step=0.5, group=G_RSI)
rearmBuf    = input.float(10.0, "Re-arm buffer (RSI points)", minval=1.0, step=1.0, group=G_RSI)
longCancel  = input.float(60.0, "LONG setup cancelled if RSI rises above", group=G_RSI)
shortCancel = input.float(40.0, "SHORT setup cancelled if RSI falls below", group=G_RSI)
maxWatch    = input.int(36, "Max bars a setup stays armed", minval=3, group=G_RSI)

emaA = input.int(7,   "EMA 1", minval=1, group=G_MA)
emaB = input.int(20,  "EMA 2", minval=1, group=G_MA)
emaC = input.int(50,  "EMA 3", minval=1, group=G_MA)
emaD = input.int(200, "EMA 4", minval=1, group=G_MA)

stLen  = input.int(12, "Supertrend ATR length", minval=1, group=G_ST)
stMult = input.float(4.0, "Supertrend multiplier", minval=0.1, step=0.1, group=G_ST)

htfTf      = input.timeframe("15", "Trend timeframe", group=G_MTF)
strictMode = input.bool(false, "STRICT MODE: require 15m trend agreement", group=G_MTF)
agreeBasis = input.string("Supertrend + Ribbon", "What counts as 15m agreement", options=["Supertrend + Ribbon", "Supertrend only", "Ribbon only"], group=G_MTF)
ctExtra    = input.int(1, "Extra EMA score needed for countertrend", minval=0, maxval=3, group=G_MTF)

stMode      = input.string("State (bullish/bearish now)", "5m Supertrend confirmation", options=["State (bullish/bearish now)", "Fresh flip after RSI extreme"], group=G_CONF)
minEmaScore = input.int(3, "Min EMA score (0-5)", minval=0, maxval=5, group=G_CONF)
crossBars   = input.int(5, "EMA7/EMA20 cross counts if within N bars", minval=1, group=G_CONF)
needE200    = input.bool(false, "Also require price beyond EMA 200", group=G_CONF)

rr         = input.float(2.0, "Reward : risk", minval=0.5, step=0.25, group=G_RISK)
minStopPct = input.float(0.10, "Reject if stop closer than (%)", minval=0.0, step=0.05, group=G_RISK)
maxStopPct = input.float(2.50, "Reject if stop farther than (%)", minval=0.1, step=0.1, group=G_RISK)
riskPct    = input.float(1.0, "Risk per trade (% of equity)", minval=0.1, step=0.1, group=G_RISK)
maxLev     = input.float(10.0, "Max leverage cap (notional / equity)", minval=1.0, group=G_RISK, tooltip="Keep this ≤ the margin leverage in the strategy() header (margin 10% = 10x).")
longsOn    = input.bool(true, "Trade LONGs", group=G_RISK)
shortsOn   = input.bool(true, "Trade SHORTs", group=G_RISK)
startDate  = input.time(timestamp("2025-01-01 00:00 +0000"), "Backtest start", group=G_RISK)
endDate    = input.time(timestamp("2030-01-01 00:00 +0000"), "Backtest end", group=G_RISK)

inRange = time >= startDate and time <= endDate

// ═════════════════════════════ CORE SERIES ═════════════════════════════
rsi5 = ta.rsi(close, rsiLen)
[st5, st5Dir] = ta.supertrend(stMult, stLen)
e1 = ta.ema(close, emaA)
e2 = ta.ema(close, emaB)
e3 = ta.ema(close, emaC)
e4 = ta.ema(close, emaD)

st5Bull  = st5Dir < 0
st5Bear  = st5Dir > 0
stFlipUp = st5Dir < 0 and nz(st5Dir[1]) > 0
stFlipDn = st5Dir > 0 and nz(st5Dir[1]) < 0

// 15m — last fully closed bar only (non-repainting)
htfPack() =>
    float r = ta.rsi(close, rsiLen)
    [stl, d] = ta.supertrend(stMult, stLen)
    float x1 = ta.ema(close, emaA)
    float x2 = ta.ema(close, emaB)
    float x3 = ta.ema(close, emaC)
    float x4 = ta.ema(close, emaD)
    [r[1], d[1], x1[1], x2[1], x3[1], x4[1], close[1]]

[rsiH, dirH, h1, h2, h3, h4, clH] = request.security(syminfo.tickerid, htfTf, htfPack(), lookahead=barmerge.lookahead_on)

htfBullST  = dirH < 0
htfBearST  = dirH > 0
htfRibBull = h1 > h2 and h2 > h3
htfRibBear = h1 < h2 and h2 < h3
alignL = agreeBasis == "Supertrend only" ? htfBullST : agreeBasis == "Ribbon only" ? htfRibBull : (htfBullST and htfRibBull)
alignS = agreeBasis == "Supertrend only" ? htfBearST : agreeBasis == "Ribbon only" ? htfRibBear : (htfBearST and htfRibBear)

// EMA analysis
sinceUp = ta.barssince(ta.crossover(e1, e2))
sinceDn = ta.barssince(ta.crossunder(e1, e2))
scoreL = (e1 > e2 ? 1 : 0) + (close > e2 ? 1 : 0) + (nz(sinceUp, 9999) <= crossBars ? 1 : 0) + (close > e3 ? 1 : 0) + (close > e4 ? 1 : 0)
scoreS = (e1 < e2 ? 1 : 0) + (close < e2 ? 1 : 0) + (nz(sinceDn, 9999) <= crossBars ? 1 : 0) + (close < e3 ? 1 : 0) + (close < e4 ? 1 : 0)
needL = math.min(5, minEmaScore + (alignL ? 0 : ctExtra))
needS = math.min(5, minEmaScore + (alignS ? 0 : ctExtra))
emaOkL = scoreL >= needL and (not needE200 or close > e4)
emaOkS = scoreS >= needS and (not needE200 or close < e4)

// Stop validation
pctL = (close - st5) / close * 100
pctS = (st5 - close) / close * 100
stopOkL = st5Bull and st5 < close and pctL >= minStopPct and pctL <= maxStopPct
stopOkS = st5Bear and st5 > close and pctS >= minStopPct and pctS <= maxStopPct

// ═════════════════════════════ SETUP STATE MACHINES ═════════════════════════════
var bool  lArmed  = false
var bool  lLocked = false
var bool  lTurn   = false
var bool  lFlip   = false
var int   lArmBar = 0
var float lExt    = na

if lLocked and rsi5 >= rsiOS + rearmBuf
    lLocked := false
if not lLocked and rsi5 <= rsiOS
    if not lArmed
        lArmed  := true
        lTurn   := false
        lFlip   := false
        lArmBar := bar_index
        lExt    := rsi5
    else if rsi5 < lExt
        lExt  := rsi5
        lTurn := false
        lFlip := false
if lArmed
    if rsi5 > rsi5[1] and rsi5 - lExt >= turnMin
        lTurn := true
    if stFlipUp
        lFlip := true

lStOk  = st5Bull and (stMode == "Fresh flip after RSI extreme" ? lFlip : true)
lReady = lArmed and lTurn and lStOk and emaOkL and (not strictMode or alignL) and stopOkL and rsi5 <= longCancel
sigLong = lReady and barstate.isconfirmed

if sigLong
    lArmed  := false
    lLocked := true
else if lArmed
    if rsi5 > longCancel
        lArmed := false
    else if bar_index - lArmBar >= maxWatch
        lArmed  := false
        lLocked := true

var bool  sArmed  = false
var bool  sLocked = false
var bool  sTurn   = false
var bool  sFlip   = false
var int   sArmBar = 0
var float sExt    = na

if sLocked and rsi5 <= rsiOB - rearmBuf
    sLocked := false
if not sLocked and rsi5 >= rsiOB
    if not sArmed
        sArmed  := true
        sTurn   := false
        sFlip   := false
        sArmBar := bar_index
        sExt    := rsi5
    else if rsi5 > sExt
        sExt  := rsi5
        sTurn := false
        sFlip := false
if sArmed
    if rsi5 < rsi5[1] and sExt - rsi5 >= turnMin
        sTurn := true
    if stFlipDn
        sFlip := true

sStOk  = st5Bear and (stMode == "Fresh flip after RSI extreme" ? sFlip : true)
sReady = sArmed and sTurn and sStOk and emaOkS and (not strictMode or alignS) and stopOkS and rsi5 >= shortCancel
sigShort = sReady and barstate.isconfirmed

if sigShort
    sArmed  := false
    sLocked := true
else if sArmed
    if rsi5 < shortCancel
        sArmed := false
    else if bar_index - sArmBar >= maxWatch
        sArmed  := false
        sLocked := true

// ═════════════════════════════ ORDERS ═════════════════════════════
var float riskSum = 0.0
var int   entries = 0

if sigLong and longsOn and inRange and strategy.position_size == 0
    float dist = close - st5
    float qty  = math.min(strategy.equity * riskPct / 100 / dist, strategy.equity * maxLev / close)
    if qty > 0
        strategy.entry("L", strategy.long, qty=qty)
        strategy.exit("L-exit", from_entry="L", stop=st5, limit=close + rr * dist)
        riskSum += qty * dist
        entries += 1

if sigShort and shortsOn and inRange and strategy.position_size == 0
    float dist = st5 - close
    float qty  = math.min(strategy.equity * riskPct / 100 / dist, strategy.equity * maxLev / close)
    if qty > 0
        strategy.entry("S", strategy.short, qty=qty)
        strategy.exit("S-exit", from_entry="S", stop=st5, limit=close - rr * dist)
        riskSum += qty * dist
        entries += 1

plot(st5Bull ? st5 : na, "Supertrend up",   color=color.new(#00C853, 0), style=plot.style_linebr)
plot(st5Bear ? st5 : na, "Supertrend down", color=color.new(#FF1744, 0), style=plot.style_linebr)
plot(e1, "EMA 1", color=color.new(#00E5FF, 0))
plot(e2, "EMA 2", color=color.new(#FFD600, 0))
plot(e3, "EMA 3", color=color.new(#FF9100, 0))
plot(e4, "EMA 4", color=color.new(#E040FB, 0), linewidth=2)
plotshape(sigLong,  "LONG signal",  shape.labelup,   location.belowbar, color.new(#00C853, 0), text="L", textcolor=color.white, size=size.tiny)
plotshape(sigShort, "SHORT signal", shape.labeldown, location.abovebar, color.new(#FF1744, 0), text="S", textcolor=color.white, size=size.tiny)

// ═════════════════════════════ BACKTEST SUMMARY TABLE ═════════════════════════════
var table tbl = table.new(position.bottom_right, 2, 9, bgcolor=color.new(#131722, 0), frame_color=color.new(#434651, 0), frame_width=1, border_color=color.new(#434651, 0), border_width=1)

if barstate.islast
    int n = strategy.closedtrades
    float avgRisk = entries > 0 ? riskSum / entries : na
    float expUsd  = n > 0 ? strategy.netprofit / n : na
    float expR    = (n > 0 and not na(avgRisk) and avgRisk > 0) ? expUsd / avgRisk : na
    table.cell(tbl, 0, 0, "BACKTEST (not live)", text_color=color.white, bgcolor=color.new(#1E222D, 0), text_size=size.small)
    table.merge_cells(tbl, 0, 0, 1, 0)
    table.cell(tbl, 0, 1, "Trades",      text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 1, str.tostring(n), text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 2, "Win rate",    text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 2, n > 0 ? str.tostring(strategy.wintrades * 100.0 / n, "#.0") + "%" : "–", text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 3, "Net profit",  text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(strategy.netprofit, "#.##"), text_color=strategy.netprofit >= 0 ? #00C853 : #FF1744, text_size=size.small)
    table.cell(tbl, 0, 4, "Max drawdown", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 4, str.tostring(strategy.max_drawdown, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 5, "Expectancy $/trade", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 5, na(expUsd) ? "–" : str.tostring(expUsd, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 6, "Expectancy ≈R", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 6, na(expR) ? "–" : str.tostring(expR, "#.00") + "R", text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 7, "Break-even win % @RR", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 7, str.tostring(100.0 / (rr + 1.0), "#.0") + "% (before costs)", text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 8, "Costs", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 8, "See Properties tab", text_color=color.white, text_size=size.small)
